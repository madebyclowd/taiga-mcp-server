{
  "name": "@madebyclowd/taiga-mcp-server",
  "version": "1.0.1",
  "description": "MCP server connecting Claude, Cursor, Windsurf, and other AI assistants to Taiga (Cloud and self-hosted) — projects, epics, user stories, tasks, issues, sprints, wiki, and more.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "taiga",
    "taiga-mcp",
    "project-management",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "windsurf",
    "ai-agent",
    "ai-assistant",
    "agile",
    "scrum",
    "kanban",
    "llm-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyclowd/taiga-mcp-server.git"
  },
  "homepage": "https://github.com/madebyclowd/taiga-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/madebyclowd/taiga-mcp-server/issues"
  },
  "engines": {
    "node": "^22.11.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "taiga-mcp-server": "./dist/transports/stdio/cli.js",
    "taiga-mcp-server-http": "./dist/transports/http/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest",
    "audit": "pnpm audit",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-hp3w-g68c-fv3c"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ],
    "*.{ts,js,json,md}": [
      "prettier --write"
    ]
  }
}
