{
  "name": "@madebyclowd/taiga-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Taiga (Cloud and self-hosted) — projects, epics, user stories, tasks, issues, sprints, wiki, and more.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "taiga",
    "project-management",
    "claude",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyclowd/taiga-mcp-server.git"
  },
  "homepage": "https://github.com/madebyclowd/taiga-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/madebyclowd/taiga-mcp-server/issues"
  },
  "engines": {
    "node": "^22.11.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "taiga-mcp-server": "./dist/transports/stdio/cli.js",
    "taiga-mcp-server-http": "./dist/transports/http/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:watch": "vitest",
    "audit": "pnpm audit",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ],
    "*.{ts,js,json,md}": [
      "prettier --write"
    ]
  }
}
