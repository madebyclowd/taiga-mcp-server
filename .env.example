# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Your Taiga instance base URL (no trailing slash).
TAIGA_BASE_URL=https://api.taiga.io

# Option A: personal auth token (preferred if you have one)
# TAIGA_TOKEN=

# Option B: username/password (used only if TAIGA_TOKEN is unset)
TAIGA_USERNAME=
TAIGA_PASSWORD=
