# Integration Test Suite Environment Variables
# Copy to .env.test or set in CI environment variables.

# Target Taiga instance base URL (default: https://api.taiga.io)
TAIGA_TEST_BASE_URL=https://api.taiga.io

# Project slug on the target instance reserved for CI integration testing.
# Note: Taiga Cloud auto-prefixes public-project slugs with the owner's
# username (e.g. requesting "mcp-ci-test-project" as owner "alice" gets
# you "alice-mcp-ci-test-project") — check the actual slug returned on
# project creation rather than assuming the requested one stuck.
TAIGA_TEST_PROJECT_SLUG=mcp-ci-test-project

# Option A: Pre-generated test auth token
# TAIGA_TEST_TOKEN=

# Option B: Test account username and password
TAIGA_TEST_USERNAME=
TAIGA_TEST_PASSWORD=
